# Copy this to .env on each Pi (never commit .env — it contains secrets).
#
#   cp .env.example .env
#   nano .env
#
# One .env per Raspberry Pi. Use a unique SITE_LABEL / PUBLIC_URL per device
# when running multiple Pis. See docs/MULTI-PI.md.

# Web UI admin login password (full control: start/stop, settings, delete)
USC_PASSWORD=changeme

# Optional viewer password (read-only: browse, download, inspect, reports).
# Leave empty to disable viewer sign-in.
USC_VIEWER_PASSWORD=

# Session cookie signing key — generate a UNIQUE value per Pi:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-please

# Web server port (Cloudflare Tunnel points here)
PORT=8080

# Human-readable label shown in the web UI (unique per site)
SITE_LABEL=Site A

# IANA timezone for multi-run report hourly profiles / night shading (DST-aware).
# Default Europe/Amsterdam. Do not use bare "CET" (fixed UTC+1).
SITE_TIMEZONE=Europe/Amsterdam

# This Pi's public URL (unique per Pi / tunnel)
PUBLIC_URL=https://noise.mattszaszko.com

# Logical device id written into every JSONL event.
# Leave empty to use the Pi hostname (recommended for multi-Pi).
DEVICE_ID=

# ALSA capture device — stable across card renumbering (same HAT on each Pi)
ALSA_DEVICE=plughw:CARD=sndrpigooglevoi,DEV=0

# Seconds to wait before poweroff after clicking Shut down Pi (default 60)
SHUTDOWN_GRACE_SEC=60
