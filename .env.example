# Copy this to .env and fill in your values.
# The .env file is gitignored — never commit it.

# Web UI password (choose something strong)
USC_PASSWORD=changeme

# Secret key for session cookies (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-please

# Port the web server listens on (Cloudflare Tunnel will point here)
PORT=8080

# Default collector settings shown in the UI
DEVICE_ID=pi-test-01
ALSA_DEVICE=plughw:CARD=sndrpigooglevoi,DEV=0
YAMNET_GAIN=15.0
